{
  "name": "FeeFlow — School Fees Made Simple",
  "short_name": "FeeFlow",
  "description": "Kenyan school fees: set your fee structure, collect by M-Pesa, and let parents see balances and print receipts.",
  "id": "./",
  "start_url": "./portal.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f4f6fa",
